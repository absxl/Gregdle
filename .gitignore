# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# cloudflare / opennext
.open-next/
.wrangler/

# pipeline caches (raw scraped HTML — re-fetchable, do not commit)
pipeline/cache/

# typescript
*.tsbuildinfo
next-env.d.ts

# zcode session data
.zcode/

# supabase cli local state
supabase/.temp/

# playwright
/test-results/
/playwright-report/
