# Supabase — public values (also mirrored in wrangler.jsonc vars).
# The publishable key is the new name for the legacy "anon" key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret (sb_secret_...). NEVER commit the real value —
# in production it is a Cloudflare dashboard Secret; locally put it in .env.local.
SUPABASE_SECRET_KEY=

# Canonical site URL (also a wrangler.jsonc var — the worker delivers it at runtime).
NEXT_PUBLIC_SITE_URL=https://gregdle.party

# Ads (optional — slots render placeholders until these exist).
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_VENATUS_ID=
